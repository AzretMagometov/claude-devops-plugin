# Settings of the devops scripts. Copy to ~/.config/devops/env (chmod 600).
# A variable of the same name in the environment wins over this file.

# Server admin user created by vps-init; all scripts log in as it. Required.
DEVOPS_ADMIN=ops
# Public key put into the admin's authorized_keys. Default ~/.ssh/id_ed25519.pub.
DEVOPS_PUBKEY_FILE=$HOME/.ssh/id_ed25519.pub
# Addresses fail2ban never bans, besides loopback: own servers, home IP. Default empty.
DEVOPS_IGNOREIP="203.0.113.10 198.51.100.20"
# Server time zone set by vps-init. Empty = leave the server's zone unchanged.
DEVOPS_TZ=UTC
# Let's Encrypt account address for web-init (an argument overrides it).
DEVOPS_ACME_EMAIL=ops@example.com
# Where the repositories live: forgejo (default) or github. Picks the CI
# template and how add-project.sh sets the repository secrets.
DEVOPS_FORGE=forgejo
# Forgejo host: container registry and API for add-project.sh. Not used with
# github: the registry there is always ghcr.io.
DEVOPS_REGISTRY=git.example.com
# Fallback owner of the repositories and images. Scripts take the owner (a
# user or an organization) from the project's git remote first, then from
# "repo" in .devops-config; this key is used only when neither gives one.
# Also the default of DEVOPS_REGISTRY_LOGIN.
DEVOPS_REGISTRY_USER=ops
# Registry login: a real user (an organization cannot log in). Goes to
# REGISTRY_USER in /opt/<app>/.env and to the repository variable
# REGISTRY_USER when the owner differs. Default DEVOPS_REGISTRY_USER.
DEVOPS_REGISTRY_LOGIN=ops
# Command that prints the Forgejo API token for add-project.sh; the token
# lives in the keychain, never in this file. FORGEJO_API_TOKEN in the
# environment wins. Scopes write:repository and write:organization (secrets
# of an organization repository; the login must be an owner of it). Store it:
#   macOS:  security add-generic-password -s devops-forgejo -a ops -w
#   Linux:  secret-tool store --label=devops-forgejo service devops-forgejo account ops
DEVOPS_FORGEJO_TOKEN_CMD="security find-generic-password -s devops-forgejo -a ops -w"
# Linux: DEVOPS_FORGEJO_TOKEN_CMD="secret-tool lookup service devops-forgejo account ops"
