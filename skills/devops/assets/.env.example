# Environment of the project stack (assets/compose.yml).
# Copy to .env and fill in every value. Never commit .env.
# The production .env lives only on the server: /opt/<app>/.env, root:deployer 640.
# It never passes through CI.
#
# Values containing '$' go in single quotes: Compose expands an unquoted '$'
# in this file, and the value reaches the container truncated.

# --- Project ---
# Compose project name = repository name. Unique per server: it names
# the containers, the backend network, the volumes, the Traefik routers and
# the image path <registry>/<owner>/<name>.
COMPOSE_PROJECT_NAME=
# Host the server Traefik routes to this project. Its A record must point at
# the server before the first deploy. TLS and the Let's Encrypt address belong
# to the server Traefik stack (/opt/traefik/.env), not here.
SITE_DOMAIN=
# More hosts the routers of this project may serve (www.<domain>, api.<domain>),
# separated by commas or spaces. deploy-app refuses a Traefik rule or
# certificate for a host that is neither here nor in SITE_DOMAIN.
ALLOWED_HOSTS=

# --- Image ---
# deploy-app reads IMAGE, REGISTRY_USER and REGISTRY_TOKEN from this file and
# passes IMAGE and IMAGE_TAG to compose in the environment.
# Image without tag, required: <DEVOPS_REGISTRY>/<owner>/<COMPOSE_PROJECT_NAME>,
# e.g. git.example.com/ops/myapp; on GitHub ghcr.io/<owner>/<repo> in lower case.
IMAGE=
# Commit hash of the build to run. Set it here only for a manual `compose up`.
IMAGE_TAG=
# Registry login. Empty = the <owner> segment of IMAGE. On GitHub: the login
# of the token owner when the owner is an organization.
REGISTRY_USER=
# Pull token: Forgejo token with the read:package scope, or on GitHub a
# personal access token (classic) with read:packages. deploy-app logs in to
# the registry of IMAGE with it to pull the image. Read-only: it cannot push.
REGISTRY_TOKEN=

# --- PostgreSQL ---
# DATABASE_URL is assembled from these in compose.yml. The password lands
# inside a URL: keep it clear of '@', ':', '/', '?', '#', '%'.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
