#!/usr/bin/env bash
# Rollout of one project on a server shared by several. Installed by web-init
# as /usr/local/bin/deploy-app (root:root 755) and run only as the forced
# command of a deployer key, one line per project in
# /home/deployer/.ssh/authorized_keys:
#
#   restrict,command="/usr/local/bin/deploy-app <app>" ssh-ed25519 AAAA... <app>-deploy@forgejo
#
# The project name comes from that line, which belongs to root. The caller
# sends only SSH_ORIGINAL_COMMAND, and it must be exactly `deploy <40-hex>`.
#
# Layout (scripts/add-project.sh creates it):
#
#   /opt/<app>                root:root 755       deployer cannot replace files in it
#   /opt/<app>/.env           root:deployer 640   read, never written
#   /opt/<app>/state          deployer 755        the only place deployer writes:
#                             last-known-good, deploy.log, deploy.lock,
#                             pre-deploy.sql.gz, docker/ (registry login)
#   /opt/<app>/compose-policy-allow
#                             root:root 644       optional, exceptions to the
#                             compose policy (below), written by hand
#   /home/deployer, .ssh      root:root 755       deployer cannot swap its keys
#   .ssh/authorized_keys      root:root 644
#
# Variables read from .env (never sourced):
#   IMAGE            required; image without tag, <registry>/<owner>/<name>;
#                    the registry host is its first path segment
#   REGISTRY_TOKEN   required; read:package token for the registry
#   REGISTRY_USER    registry login, default the <owner> segment of IMAGE
#
# The compose file comes from the image (/app/docker-compose.yml), so a tag
# means code and stack layout at once and a rollback brings the old stack back.
# /opt/<app>/docker-compose.yml is the fallback for images without it.
# Compose gets IMAGE and IMAGE_TAG in the environment, which wins over .env.
#
# One image, one compose. The CI token can push to the registry, so a tag
# may name another image a minute later. After `docker pull` the tag is
# resolved to its image ID once; the compose file is read once from that ID
# (`docker run` of an ID never pulls) and kept in memory, and every compose
# call of the run gets those bytes. After `compose pull`, which pulls the app
# tag again with the rest of the stack, the tag must still name that ID, and
# `up --pull never` starts what is on disk: a tag re-pushed in between stops
# the run before production changes. The rollback pulls the previous tag
# explicitly (the weekly prune may have removed it) and goes the same way.
#
# Compose policy. deployer is in the docker group and the compose file comes
# from whoever can push to main, so the file decides what runs as root on a
# server shared with other projects. Before any change to production, and
# again before a rollback, the stack of the tag is rendered with
# `docker compose config --format json` and checked with jq. A finding is a
# token, <service>.<key> or <top-level section>.<name>.<key>:
#   <svc>.privileged                     privileged: true
#   <svc>.network_mode|pid|ipc|uts|cgroup|userns_mode
#                                        host, or container:<other>
#   <svc>.cap_add|devices|device_cgroup_rules
#                                        not empty
#   <svc>.security_opt                   an *unconfined* apparmor or seccomp
#   <svc>.volumes_from:container:<name>  volumes of a container outside the stack
#   <svc>.volumes:<source>               a bind mount whose source is not a
#                                        direct child of /opt/<app>/ (the
#                                        docker socket too, anything deeper,
#                                        `..`), is compose-policy-allow or
#                                        state/, or is a symlink on disk
#   volumes.<name>.external|driver|driver_opts|name
#                                        external, a driver other than local,
#                                        driver_opts (a bind in disguise), or
#                                        a name without the <app>_ prefix or
#                                        with the <other>_ prefix of a project
#                                        /opt/<other> named <app>_*
#   networks.<name>.external|name        external other than proxy, or a name
#                                        as for volumes
#   secrets|configs.<name>.file          a file by the same rule as a bind
# Named volumes, tmpfs and binds of direct children of /opt/<app>/ pass. Why
# direct children: container root writes as host root, so below a bound
# directory a container can plant a symlink, and a later rollout binding that
# path would mount whatever it points to on the host. /opt/<app> itself is
# root:root 755 and never bound, so no container can create or swap an entry
# in it: a direct child that is not a symlink when checked stays so until
# `up`. state/ is deployer's (last-known-good, registry login), not the
# stack's. Volume and network names: compose names them <app>_<name>, and
# with a project demo_x on the server, volume x_data of demo is demo_x_data,
# the volume data of demo_x; such a name is a finding too. Any finding stops
# the run. Root grants
# an exception in /opt/<app>/compose-policy-allow: one token per line,
# exactly as the refusal prints it; `#` starts a comment.
#   # the vpn sidecar manages routes
#   vpn.cap_add
#   app.volumes:/srv/shared
# An exception for a deeper bind brings the symlink case back for that path:
# root's call. The file must be a regular file of root, writable by root
# alone; otherwise the run stops: deployer must not grant itself exceptions.
set -euo pipefail

HEALTH_TIMEOUT=180
COMPOSE_IN_IMAGE=/app/docker-compose.yml

# The compose policy (header) over the JSON of `docker compose config`, which
# gives volumes in long syntax with sources resolved against /opt/<app> and
# top-level names already prefixed with the project. Prints one token per
# finding.
# shellcheck disable=SC2016 # jq variables
POLICY_DEFS='
  def ns_escape: type == "string" and (. == "host" or startswith("container:"));
  def child: ($dir + "/") as $p | select(startswith($p)) | .[($p | length):];
  def outside: [child | select(. != "" and . != "." and . != ".." and . != "state"
    and . != "compose-policy-allow" and (contains("/") | not))] | length == 0;
  def foreign: (startswith($app + "_") | not) or (. as $n | any($longer[]; . as $o | $n | startswith($o + "_")));
'
# shellcheck disable=SC2016 # jq variables
POLICY=$POLICY_DEFS'
  (.services // {} | to_entries[] | .key as $svc | .value | (
      (select(.privileged == true) | "privileged"),
      (("network_mode", "pid", "ipc", "uts", "cgroup", "userns_mode") as $k
        | select(.[$k] | ns_escape) | $k),
      (("cap_add", "devices", "device_cgroup_rules") as $k
        | select(.[$k] // [] | length > 0) | $k),
      (select(any(.security_opt[]?; test("unconfined"))) | "security_opt"),
      (.volumes_from[]? | select(startswith("container:")) | "volumes_from:" + .),
      (.volumes[]? | select(.type == "bind") | .source | select(outside) | "volumes:" + .)
    ) | "\($svc).\(.)"),
  (.volumes // {} | to_entries[] | .key as $v | .value | (
      (select(.external == true) | "external"),
      (select(.driver != null and .driver != "local") | "driver"),
      (select(.driver_opts != null) | "driver_opts"),
      (select(.external != true and (.name // ($app + "_") | foreign)) | "name")
    ) | "volumes.\($v).\(.)"),
  (.networks // {} | to_entries[] | .key as $n | .value | (
      (select(.external == true and .name != "proxy") | "external"),
      (select(.external != true and (.name // ($app + "_") | foreign)) | "name")
    ) | "networks.\($n).\(.)"),
  (("secrets", "configs") as $sec | .[$sec] // {} | to_entries[]
    | select(.value.file != null and (.value.file | outside))
    | "\($sec).\(.key).file")
'
# The sources that pass POLICY as paths, "<token>\t<path>": a symlink among
# them is a finding too, which only the file system knows.
# shellcheck disable=SC2016 # jq variables
BIND_SOURCES=$POLICY_DEFS'
  (.services // {} | to_entries[] | .key as $svc | .value.volumes[]?
    | select(.type == "bind" and (.source | outside | not)) | "\($svc).volumes:\(.source)\t\(.source)"),
  (("secrets", "configs") as $sec | .[$sec] // {} | to_entries[]
    | select(.value.file != null and (.value.file | outside | not))
    | "\($sec).\(.key).file\t\(.value.file)")
'

log() { printf '%s  %s\n' "$(date +%H:%M:%S)" "$*" >&2; }
die() { log "ERROR: $*"; exit 1; }

# --- project --------------------------------------------------------------
[[ $# -eq 1 ]] || die "usage: deploy-app <app> (from authorized_keys)"
APP=$1
[[ $APP =~ ^[a-z0-9][a-z0-9_-]{0,40}$ ]] || die "project name \"${APP}\" does not match ^[a-z0-9][a-z0-9_-]{0,40}$"
PROJECT_DIR=/opt/$APP
STATE_DIR=$PROJECT_DIR/state
cd "$PROJECT_DIR" 2>/dev/null || die "no directory ${PROJECT_DIR}"
[[ -w $STATE_DIR ]] || die "${STATE_DIR} is not writable"

# Everything sent to the CI session is copied into state/deploy.log: the step
# log of Forgejo Actions is not readable through the API.
exec 2> >(tee -a "$STATE_DIR/deploy.log" >&2)
printf '\n=== %s  %s  %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$APP" "${SSH_ORIGINAL_COMMAND:-<empty>}" >&2

# --- command --------------------------------------------------------------
# The whole string is matched: no second word, no extra spaces, no moving
# names like latest. A tag means one image forever.
[[ ${SSH_ORIGINAL_COMMAND:-} =~ ^deploy\ ([0-9a-f]{40})$ ]] \
  || die "expected \"deploy <tag>\", got: ${SSH_ORIGINAL_COMMAND:-<empty>}"
TAG=${BASH_REMATCH[1]}

# CI serialises rollouts of one repository; this lock is the backstop for a
# manual run racing a push. A second run fails at once instead of queueing a
# stale tag.
exec 9> "$STATE_DIR/deploy.lock"
flock -n 9 || die "another rollout of ${APP} is running, retry later"

command -v jq > /dev/null || die "jq is not installed, the compose policy cannot run (web-init installs it)"

# --- compose policy exceptions ---------------------------------------------
ALLOW_FILE=$PROJECT_DIR/compose-policy-allow
if [[ -e $ALLOW_FILE || -L $ALLOW_FILE ]]; then
  read -r allow_uid allow_mode < <(stat -c '%u %a' "$ALLOW_FILE")
  if [[ -L $ALLOW_FILE || ! -f $ALLOW_FILE || $allow_uid != 0 ]] || (( 8#$allow_mode & 8#022 )); then
    die "${ALLOW_FILE} must be a regular file of root, writable by root alone (chown root:root, chmod 644); production untouched"
  fi
fi
# The granted tokens: comments, blanks around them and empty lines dropped
# (an empty pattern would match every finding).
allowed_tokens() {
  [[ -e $ALLOW_FILE ]] || return 0
  sed -e 's/#.*//' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' "$ALLOW_FILE" | grep -v '^$' || true
}

# --- .env -----------------------------------------------------------------
[[ -r .env ]] || die "cannot read ${PROJECT_DIR}/.env"
env_get() {
  local v
  v=$(grep -E "^$1=" .env | tail -n1 | cut -d= -f2-) || true
  [[ $v =~ ^\"(.*)\"$ || $v =~ ^\'(.*)\'$ ]] && v=${BASH_REMATCH[1]}
  printf '%s' "$v"
}
IMAGE=$(env_get IMAGE)
[[ -n $IMAGE ]] || die "no IMAGE in ${PROJECT_DIR}/.env (form <registry>/<owner>/${APP})"
REGISTRY=${IMAGE%%/*}
REGISTRY_USER=$(env_get REGISTRY_USER)
# Forgejo: the owner of the package path logs in as itself.
[[ -n $REGISTRY_USER || ! $IMAGE =~ ^[^/]+/([^/]+)/ ]] || REGISTRY_USER=${BASH_REMATCH[1]}
[[ -n $REGISTRY_USER ]] || die "no REGISTRY_USER in ${PROJECT_DIR}/.env, and IMAGE=${IMAGE} has no owner"
TOKEN=$(env_get REGISTRY_TOKEN)
[[ -n $TOKEN ]] || die "no REGISTRY_TOKEN in ${PROJECT_DIR}/.env"

STATE_FILE=$STATE_DIR/last-known-good
PREVIOUS=$(cat "$STATE_FILE" 2>/dev/null || true)
log "rollout ${APP} ${TAG} (now ${PREVIOUS:-<unknown>})"

# --- registry -------------------------------------------------------------
# Credentials per project, inside state/: projects on one server log in as
# different users, and the deployer home stays root-owned.
export DOCKER_CONFIG=$STATE_DIR/docker
printf '%s' "$TOKEN" | docker login "$REGISTRY" -u "$REGISTRY_USER" --password-stdin > /dev/null \
  || die "registry ${REGISTRY} refused the login"

# --- image and its compose file -------------------------------------------
# A tag missing from the registry shows here, before any container changes.
docker pull --quiet "${IMAGE}:${TAG}" > /dev/null || die "image ${IMAGE}:${TAG} did not download; production untouched"

# image_id <tag>: the local image the tag names now.
image_id() { docker image inspect --format '{{.Id}}' "${IMAGE}:$1" 2>/dev/null; }

# compose_of <image id> <tag>: the compose file inside that image, read by ID.
compose_of() {
  docker run --rm --pull never --entrypoint cat "$1" "$COMPOSE_IN_IMAGE" 2>/dev/null || {
    log "image $2 has no ${COMPOSE_IN_IMAGE}, using ${PROJECT_DIR}/docker-compose.yml"
    cat "$PROJECT_DIR/docker-compose.yml"
  }
}

# compose <tag> <compose file text> <args...>. The compose file arrives on
# stdin, so the project name is given explicitly: volumes are bound to <app>_*.
compose() {
  IMAGE="$IMAGE" IMAGE_TAG="$1" docker compose \
    --project-name "$APP" \
    --project-directory "$PROJECT_DIR" \
    --env-file "$PROJECT_DIR/.env" \
    -f - "${@:3}" <<< "$2"
}

# policy_findings <tag> <compose file text>: the findings of that stack not
# granted by the allow file, comma-separated; fails when compose cannot
# render it.
policy_findings() {
  local json
  json=$(compose "$1" "$2" config --format json) && [[ -n $json ]] || return 1
  # The projects named <app>_*: their volumes and networks are <app>_* too.
  local longer
  longer=$(find /opt -mindepth 1 -maxdepth 1 -type d -name "${APP}_*" -printf '%f\n' | jq -Rnc '[inputs]')
  local jq_args=(-r --arg app "$APP" --arg dir "$PROJECT_DIR" --argjson longer "$longer")
  {
    jq "${jq_args[@]}" "$POLICY" <<< "$json"
    jq "${jq_args[@]}" "$BIND_SOURCES" <<< "$json" | while IFS=$'\t' read -r token src; do
      [[ ! -L $src ]] || printf '%s\n' "$token"
    done
  } | { grep -Fxv -f <(allowed_tokens) || true; } | paste -sd, - | sed 's/,/, /g'
}

TAG_ID=$(image_id "$TAG") || die "image ${IMAGE}:${TAG} is not on disk after the pull; production untouched"
TAG_COMPOSE=$(compose_of "$TAG_ID" "$TAG") || die "no compose file for ${TAG}; production untouched"

# Before the stack images are pulled, the dump and up: a refused stack
# changes nothing.
FINDINGS=$(policy_findings "$TAG" "$TAG_COMPOSE") || die "compose of ${TAG} does not render; production untouched"
[[ -z $FINDINGS ]] \
  || die "compose of ${TAG} refused by the server policy: ${FINDINGS}; root may grant exceptions in ${ALLOW_FILE}; production untouched"

compose "$TAG" "$TAG_COMPOSE" pull --quiet || die "stack images for ${TAG} did not download; production untouched"
[[ $(image_id "$TAG") == "$TAG_ID" ]] \
  || die "image ${IMAGE}:${TAG} changed in the registry during the rollout (was ${TAG_ID}); production untouched"

# --- database dump before migrations --------------------------------------
# One rolling file, overwritten by every rollout: the state just before the
# migrate service of this tag touches the schema. The dump runs in the running
# postgres container as its POSTGRES_USER and covers every database of the
# cluster except templates: a project may keep a second database there, as
# an error tracker keeps its own. Each database is a `pg_dump --clean --if-exists`
# after a `\connect` to it, so psql restores the whole file over the live
# cluster from any database. Not pg_dumpall: its --clean drops the databases
# and the role in use, which fails on a live cluster. Mode 600: the data stays
# deployer's. A failed dump of any database stops the rollout: a migration
# without a way back is not started.
PG=$(docker ps -q --filter "label=com.docker.compose.project=${APP}" \
  --filter label=com.docker.compose.service=postgres --filter status=running)
if [[ -z $PG ]]; then
  log "postgres of ${APP} not running: pre-deploy dump skipped"
else
  # The list is read before the loop: `set -e` does not see a failed command
  # substitution in a `for` word list.
  # shellcheck disable=SC2016 # expanded by sh in the container
  docker exec "$PG" sh -c 'set -e
      dbs=$(psql -U "$POSTGRES_USER" -d "$POSTGRES_DB" -Atc \
        "SELECT datname FROM pg_database WHERE NOT datistemplate AND datallowconn ORDER BY 1")
      [ -n "$dbs" ]
      for db in $dbs; do
        printf "%s\n" "\\connect \"$db\""
        pg_dump --clean --if-exists -U "$POSTGRES_USER" -d "$db"
      done' \
    | (umask 077 && gzip > "$STATE_DIR/pre-deploy.sql.gz.tmp") \
    || die "pg_dump failed; production untouched"
  mv "$STATE_DIR/pre-deploy.sql.gz.tmp" "$STATE_DIR/pre-deploy.sql.gz"
  log "dump of all databases: ${STATE_DIR}/pre-deploy.sql.gz ($(du -h "$STATE_DIR/pre-deploy.sql.gz" | cut -f1))"
fi

# --- rollout --------------------------------------------------------------
# `up --wait` starts services in dependency order: the one-shot migrate
# finishes before the app starts. Health is the container healthcheck, not a
# request through Traefik, which answers 404 for an unhealthy container.
if compose "$TAG" "$TAG_COMPOSE" up -d --pull never --remove-orphans --wait --wait-timeout "$HEALTH_TIMEOUT"; then
  echo "$TAG" > "$STATE_FILE"
  log "rollout succeeded, ${TAG} recorded as last known good"
  docker image prune -f > /dev/null
  exit 0
fi

# --- rollback -------------------------------------------------------------
# The schema stays: rollback works because migrations are compatible with the
# previous image, and its migrate command exits 0 on a database ahead of it
# (references/migration-patterns.md). pre-deploy.sql.gz is there for the case
# when they are not.
log "stack not healthy in ${HEALTH_TIMEOUT}s, rolling back to ${PREVIOUS:-<nothing>}"
compose "$TAG" "$TAG_COMPOSE" logs --tail 40 --no-color >&2 || true

[[ -n $PREVIOUS ]] \
  || die "no previous tag, nothing to roll back to: needs a human"
# last-known-good sits in the deployer-writable state/, and the previous
# stack is checked as strictly as a new one: an exception revoked since its
# rollout keeps it down.
[[ $PREVIOUS =~ ^[0-9a-f]{40}$ ]] \
  || die "last-known-good holds \"${PREVIOUS}\", not a tag: not rolling back, needs a human"
docker pull --quiet "${IMAGE}:${PREVIOUS}" > /dev/null \
  || die "image ${IMAGE}:${PREVIOUS} did not download: not rolling back, needs a human"
PREV_ID=$(image_id "$PREVIOUS") \
  || die "image ${IMAGE}:${PREVIOUS} is not on disk after the pull: not rolling back, needs a human"
PREV_COMPOSE=$(compose_of "$PREV_ID" "$PREVIOUS") \
  || die "no compose file for ${PREVIOUS}: not rolling back, needs a human"
FINDINGS=$(policy_findings "$PREVIOUS" "$PREV_COMPOSE") \
  || die "compose of the previous tag ${PREVIOUS} does not render: not rolling back, needs a human"
[[ -z $FINDINGS ]] \
  || die "previous tag ${PREVIOUS} refused by the server policy: ${FINDINGS}; not rolling back, needs a human"
compose "$PREVIOUS" "$PREV_COMPOSE" pull --quiet \
  || die "stack images for ${PREVIOUS} did not download: not rolling back, needs a human"
[[ $(image_id "$PREVIOUS") == "$PREV_ID" ]] \
  || die "image ${IMAGE}:${PREVIOUS} changed in the registry during the rollback (was ${PREV_ID}): not rolling back, needs a human"

if compose "$PREVIOUS" "$PREV_COMPOSE" up -d --pull never --remove-orphans --wait --wait-timeout "$HEALTH_TIMEOUT"; then
  die "rollout of ${TAG} failed, ${APP} rolled back to ${PREVIOUS}"
fi
die "rollout of ${TAG} failed AND the rollback to ${PREVIOUS} did not come up: needs a human"
